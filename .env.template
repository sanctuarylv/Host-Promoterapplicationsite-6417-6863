# Environment
# Local development only. Production builds force NODE_ENV=production regardless
# (packages/web/vite.config.ts), but the RUNTIME (Better Auth cookies/rate limits,
# the server) still reads NODE_ENV: the deployed .env must set NODE_ENV=production
# or omit the line. See docs/RUNBOOK_V2.md § Production environment.
NODE_ENV=development
# Public origin of this deployment. Production: https://crew.sanctuarylv.org (no trailing slash)
WEBSITE_URL=http://localhost:4200
APPLICATION_ID=

# Better Auth - Configuration
# Required on the canonical/production deployment: >= 32 random characters
# (the server refuses to start otherwise — src/api/crew/production.ts).
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# ---- Sanctuary Crew (see docs/RUNBOOK_V2.md and docs/COMMAND_CENTER_CONTRACT_V2.md) ----
# Secrets stay blank here. Never commit real values.

# HMAC secret for credential/link tokens and guest keys. Falls back to BETTER_AUTH_SECRET.
# Must stay STABLE: changing it invalidates every issued credential, link code and guest key.
CREW_TOKEN_SECRET=

# Which client-IP header the deployment edge guarantees: none | cloudflare | x-real-ip | xff:N
# Keep "none" until the edge header contract is verified (spoofable headers are ignored).
CREW_TRUSTED_PROXY=none

# Legacy shared-key admin (/crew/admin): readonly (list/export only) | disabled
CREW_LEGACY_ADMIN_MODE=readonly
CREW_ADMIN_ACCESS_KEY=

# local = store + hold in the outbox (default). forward = send through the outbox.
# The canonical adapter is NOT implemented, so forward/cutover remain blocked in-app.
CREW_SUBMISSION_MODE=local
# format = local format check only. command_center = proposed lookup (unverified).
CREW_REFERRAL_VALIDATION_MODE=format

# PROPOSED Command Center contract — no production endpoint is known. Leave blank.
COMMAND_CENTER_API_BASE_URL=
COMMAND_CENTER_APPLICATIONS_PATH=
COMMAND_CENTER_REFERRAL_LOOKUP_PATH=
COMMAND_CENTER_STATUS_PATH=
COMMAND_CENTER_API_KEY=
COMMAND_CENTER_SIGNING_SECRET=
COMMAND_CENTER_TIMEOUT_MS=8000

# Public origin used for campaign tracked links (falls back to WEBSITE_URL). No trailing slash.
VITE_SANCTUARY_PUBLIC_URL=
VITE_SANCTUARY_INSTAGRAM_URL=
VITE_SANCTUARY_TIKTOK_URL=
VITE_SANCTUARY_YOUTUBE_URL=
VITE_SANCTUARY_WEBSITE_URL=

# Legal / consent links (https only). Unset = a visible "pending approval" placeholder.
# Inventory and locations: docs/LEGAL_PLACEHOLDERS_V2.md. Do not point these at draft text.
VITE_SANCTUARY_PRIVACY_URL=
VITE_SANCTUARY_TERMS_URL=
VITE_SANCTUARY_GROUP_DISCLOSURE_URL=
VITE_SANCTUARY_VOLUNTEER_TERMS_URL=
VITE_SANCTUARY_COMMUNICATIONS_URL=
VITE_SANCTUARY_DATA_RETENTION_URL=

# Absolute origin for canonical/og:url/og:image. Blank = https://crew.sanctuarylv.org.
VITE_SITE_URL=

# Extra exact origins allowed to call the auth API (comma separated, https://host only;
# wildcards are ignored). The canonical domain and WEBSITE_URL are always allowed.
CREW_EXTRA_TRUSTED_ORIGINS=

# Ticketing fixture endpoints (demo/test data): enabled | disabled.
# Blank = disabled when WEBSITE_URL is the canonical domain, enabled elsewhere.
CREW_TICKETING_FIXTURES=
